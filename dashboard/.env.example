# ── Database (Tiger Data / TimescaleDB) ──────────────────────────────
# Local docker (npm run db:up):
DATABASE_URL=postgres://postgres:badgepay@127.0.0.1:5433/badgepay
# Tiger Cloud: paste the service URL (direct connection, NOT the pooler: LISTEN/NOTIFY needs a session)
# DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# ── Solana devnet ────────────────────────────────────────────────────
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com

# BADGE-GAP(hack-mint): SPL mint address of HACK. Written by `npm run devnet:setup` for the
# stand-in mint; replace with the real mint if the badge team mints its own. Empty = feed idle.
HACK_MINT=
HACK_SYMBOL=HACK
# Only used by devnet-setup when creating a mint. The server reads decimals from the chain.
HACK_DECIMALS=2

# ── Registry authority (never leaves this laptop, never sent to the browser) ──
AUTHORITY_KEYPAIR=server/.keys/authority.json
SAS_CREDENTIAL_NAME=MHacks Verified Payees
SAS_SCHEMA_NAME=payee_v1
SAS_SCHEMA_VERSION=1

# ── HTTP ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Attack console ───────────────────────────────────────────────────
# Where the 500 HACK goes. Empty = the authority address (the laptop is the attacker).
ATTACKER_PUBKEY=
# BADGE-GAP(attack-payload): 'legacy' or '0'. Which message version the badge decoder parses.
ATTACK_TX_VERSION=legacy
# BADGE-GAP(attack-delivery): set to the laptop's hotspot IP (or 0.0.0.0) to open the
# badge-only listener (GET /badge/pending). Empty = closed, nothing is reachable from the LAN.
BADGE_LISTEN_HOST=
BADGE_LISTEN_PORT=8788

# ── Nessie (Capital One sandbox, bank rail) ──────────────────────────
# Secret: sent as ?key=. Never commit a real value.
NESSIE_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

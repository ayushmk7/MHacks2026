# BadgeOS provisioning values. PUBLIC VALUES ONLY: this file is safe to commit.
#
# Read by `os/scripts/vkdev.py provision` (docs/os/platform/config.md, "With the tool").
# Everything here is public: addresses and a public key that anyone can read from the chain,
# a public RPC endpoint, and the payment limits. No secret may ever be put in this file:
# no keypair, no AUTHORITY_KEYPAIR path, no password, no RPC URL with an API key.
# The tool refuses the file if it holds any name other than the seven below, or a value
# shaped like key material.
#
# The issuer's secret keypair stays on the backend laptop (dashboard/server/.keys/). The
# provisioning tool needs only the public half below and has no code that reads a keypair file.
#
# Pinned devnet values (final), given by the backend owner on 2026-10-04. They must equal what
# the backend uses (docs/os/integration/backend.md, "Values that must match"). A flag of
# `vkdev.py provision` (--issuer --mint --decimals --symbol --cap --max --rpc) overrides a line.

# Public key that signs registry records; also the mint authority. Badge config key: issuer_key.
ISSUER_PUBKEY=2SXh6Xng9b1qQBCEn3pt2Ucwcb4ibBWwBKuuTwNgEzJy

# The HACK token: a classic SPL Token mint (program Tokenkeg...), 2 decimals, no freeze authority.
# Badge config key: tokens = HACK_MINT:HACK_DECIMALS:HACK_SYMBOL:HACK_CAP:HACK_MAX
HACK_MINT=3VmWnzfWTfS5UGkwEjbMZnpjd1DPtKyMcwKeJc4QM9wP
HACK_DECIMALS=2
HACK_SYMBOL=HACK

# Payment limits in display units. Above HACK_CAP, SELECT becomes a hold; above HACK_MAX the
# payment is blocked. These two exist only on the badge: the dashboard's .env has no such names.
HACK_CAP=100.00
HACK_MAX=1000.00

# JSON-RPC endpoint (the public devnet one, as in dashboard/.env.example). Badge config key: rpc_url.
RPC_URL=https://api.devnet.solana.com

# Not here, because they change with the venue: the listener URL and the Wi-Fi network.
# Give them per run: --listener http://<backend laptop IP>:8788 --wifi "<SSID>" "<password>"
